# LIVE HARMONIC SCANNER - ENVIRONMENT CONFIGURATION
# Copy to .env and configure your desired data feed

# Provider Selection: AUTO | MT5 | CLOUD | DEMO
FEED_MODE=AUTO

# Persistent PostgreSQL Forward Storage (e.g. Supabase, Neon, Railway)
# If empty, automatically falls back to local SQLite storage
DATABASE_URL=""

# Optional MetaTrader 5 Terminal Configuration (for local live feeds)
MT5_PATH=""
MT5_LOGIN=""
MT5_PASSWORD=""
MT5_SERVER=""

# Optional Telegram Alert Bot Integration
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
